# ============================================================
# advance-payment-orchestrator — Environment Configuration
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# Application
NODE_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=info

# Storage paths (relative to project root)
STORAGE_INBOX_PATH=./storage/inbox
STORAGE_PROCESSED_PATH=./storage/processed
STORAGE_FAILED_PATH=./storage/failed
STORAGE_QUARANTINE_PATH=./storage/failed/quarantine
STORAGE_REPORTS_PATH=./storage/reports
STORAGE_TEMP_PATH=./storage/temp
STORAGE_DB_PATH=./storage/db/orchestrator.sqlite

# Processing thresholds
ADVANCE_PERCENTAGE=0.90
# Documentation charges (Dc) tiers on Price — see docs/DOCUMENTATION_CHARGES.md
# DC_TIERS_JSON=[{"maxPrice":15000,"amount":200},{"maxPrice":25000,"amount":300},{"maxPrice":60000,"amount":500},{"maxPrice":100000,"amount":600},{"maxPrice":1e308,"amount":700}]
TDS_LINK_MULTIPLIER=1.0
NEGATIVE_MARGIN_THRESHOLD=0
CLIENT_RATE_TOLERANCE_PCT=5
LR_NUMBER_MIN_LENGTH=4

# Excel writer options
EXCEL_FREEZE_HEADER_ROW=true
EXCEL_AUTOSIZE_COLUMNS=true
EXCEL_PROTECT_FORMULA_CELLS=false

# Google Drive (Phase 2)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Event Bus (Phase 3)
EVENTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Future: Redis / Queue (Phase 4)
REDIS_URL=
QUEUE_CONCURRENCY=1

# Browser automation
PLAYWRIGHT_BROWSERS_PATH=~/Library/Caches/ms-playwright
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=0
BROWSER_TIMEOUT=30000
BROWSER_DOWNLOAD_TIMEOUT=120000
BROWSER_MANUAL_LOGIN_TIMEOUT_MS=180000
BROWSER_SESSION_PATH=./storage/browser/session.json
BROWSER_SESSION_SECRET=
BROWSER_DEBUG_PATH=./storage/debug
BROWSER_TRACES_ENABLED=true
BROWSER_SCREENSHOTS_ENABLED=true
BROWSER_RETRY_MAX=3
BROWSER_RETRY_BASE_MS=2000

# Chrome — only profiles listed in ALLOWLIST may launch (comma-separated)
BROWSER_CHROME_PROFILE=Default
BROWSER_CHROME_PROFILE_ALLOWLIST=Default
# Sync from real Chrome once: npm run chrome:sync-profile (Chrome must be quit)
BROWSER_CHROME_USER_DATA_DIR=./storage/browser/chrome-cdp-data
# CDP attach (recommended): npm run chrome:cdp — then automation reuses that session
BROWSER_CDP_URL=http://127.0.0.1:9222
BROWSER_CDP_PORT=9222

# Digitify / desk TMS
DIGITIFY_BASE_URL=https://desk.digitify.app/payment
DIGITIFY_ACCOUNT_EMAIL=your-work-email@gogox.com
DIGITIFY_LOGIN_URL_PATHS=/login,/signin,/auth
DIGITIFY_STATUS_FILTER=VERIFIED,REJECTED
DIGITIFY_STATUS_COLUMN=Status
DIGITIFY_DOWNLOAD_DATE_RANGE_DAYS=1
DIGITIFY_SELECTOR_EXPORT_BUTTON=span.anticon-file-pdf, svg[data-icon="file-pdf"]
DIGITIFY_SELECTOR_DOWNLOAD_MENU=.ant-modal svg[data-icon="download"], .ant-modal .anticon-download
DIGITIFY_SELECTOR_EXPORT_DIALOG=.ant-modal-content
DIGITIFY_SELECTOR_STATUS_FILTER=th.ant-table-cell:has(.ant-table-column-title:text-is("Status")) .ant-table-filter-trigger
DIGITIFY_ID_COLUMN=Id
DIGITIFY_SELECTOR_ID_FILTER=th.ant-table-cell:has(.ant-table-column-title:text-is("Id")) .ant-table-filter-trigger
DIGITIFY_SELECTOR_ID_SEARCH_INPUT=input[placeholder="Search Id"]
# Id filter row → LR No cell Files → POD → Loading Memo eye (not LR Preview / Eway)
DIGITIFY_SELECTOR_LOADING_MEMO_FILES=div.break-all button.ant-btn-link:has(img[alt="Files"])
DIGITIFY_SELECTOR_LOADING_MEMO_SECTION=div.border-b:has(p.tiny-label:text-is("Loading Memo"))
DIGITIFY_SELECTOR_LOADING_MEMO_VIEW=button.ant-btn-circle.mt-2:has(.anticon-eye)
DIGITIFY_SELECTOR_DOCUMENT_IMAGE=img[alt*="POD"], img[alt*="LR"]
# LR File Preview — "Click to View Pdf File" (optional; default matches text + file-pdf icon)
DIGITIFY_SELECTOR_PDF_VIEW_CLICK=
DIGITIFY_PRICE_VALIDATION_ENABLED=true
SUPPLIER_PRICE_TOLERANCE_PCT=0

# Gemini — OCR supplier rate from Digitify documents vs Excel Price column
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Digitify login (optional when using Chrome profile)
DIGITIFY_EMAIL=
DIGITIFY_PASSWORD=

# File retention policies (days)
RETENTION_TEMP_MAX_AGE_DAYS=1
RETENTION_DEBUG_MAX_AGE_DAYS=7
RETENTION_REPORTS_MAX_AGE_DAYS=90
RETENTION_TRACES_MAX_AGE_DAYS=7
