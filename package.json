{
  "name": "digitify-automator",
  "version": "1.0.0",
  "description": "Digitify automation platform — extensible browser automation for Digitify TMS",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:mac": "bash scripts/launch-chrome-cdp.sh & sleep 3 && tsx scripts/open-digitify.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/apps/cli/index.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "process:digitify": "tsx apps/cli/index.ts process:digitify",
    "process:digitify:headless": "tsx apps/cli/index.ts process:digitify --headless",
    "validate:selectors": "tsx scripts/validate-selectors.ts",
    "digitify:uat-download": "tsx scripts/digitify-uat-download.ts",
    "chrome:sync-profile": "bash scripts/sync-chrome-profile.sh",
    "chrome:sync-profile:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-chrome-profile.ps1",
    "chrome:cdp": "bash scripts/launch-chrome-cdp.sh",
    "chrome:cdp:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-chrome-cdp.ps1",
    "clean:storage": "bash scripts/clean-storage.sh",
    "fresh": "npm run clean:storage",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\""
  },
  "dependencies": {
    "@playwright/browser-chromium": "^1.60.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.2",
    "ora": "^9.4.0",
    "pino": "^9.3.1",
    "pino-pretty": "^11.2.1",
    "playwright": "^1.60.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.2",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
